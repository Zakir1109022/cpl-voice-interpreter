# LiveKit Cloud project credentials (server-side only; never expose to the browser)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Model identifiers (LiveKit Inference; see docs/model-validation.md)
STT_MODEL=deepgram/nova-3
LLM_MODEL=openai/gpt-4o-mini
TTS_MODEL=cartesia/sonic-3

# TTS voices (Cartesia voice IDs; one per supported language)
# en/bn from the LiveKit docs voice list; ja ("Yuzuki") from the Cartesia Japanese
# voice library. All three verified to synthesize via LiveKit Inference.
TTS_VOICE_EN=47c38ca4-5f35-497b-b1a3-415245fb35e1
TTS_VOICE_BN=314be1d2-3d14-468d-be40-08a1af7df49d
TTS_VOICE_JA=aa3ccc4a-cfd8-405c-acf5-1873a527b006

# Default room language pair: bn-en (Bengali<->English), bn-ja (Bengali<->Japanese)
# or en-ja (English<->Japanese).
# A room runs exactly one pair; the join UI overrides this per room.
LANGUAGE_PAIR=bn-en

# Agent dispatch name; the web token endpoint dispatches an agent with this name
AGENT_NAME=meeting-interpreter

# Optional: token TTL in seconds (default 3600)
TOKEN_TTL_SECONDS=3600
