# LiveKit connection (client)
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-url

# LiveKit server credentials (for token API)
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Shared room every participant joins (optional, default: interpreter-room)
LIVEKIT_ROOM_NAME=interpreter-room

# Interpreter worker to dispatch; must match AGENT_NAME used by the Python agent
# (optional, default: bengali-english-interpreter)
AGENT_NAME=bengali-english-interpreter

# Access token lifetime in seconds (optional, default: 3600)
TOKEN_TTL_SECONDS=3600

